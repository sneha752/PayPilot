# PayPal REST API credentials (Sandbox)
# Create a Sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id-here
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret-here

# Only "sandbox" is supported in Phase 1
PAYPAL_ENVIRONMENT=sandbox

# Checkout return/cancel destinations (Phase 11F-B). OPTIONAL.
# Where PayPal sends the buyer after they approve or cancel on the hosted
# checkout page. Leave both unset to keep the historical defaults
# (https://example.com/paypilot/return and .../cancel) — an unconfigured
# deployment behaves exactly as it did before this phase.
#
# Each value must be an ABSOLUTE https:// URL. A relative path, http://,
# javascript:, data:, a host-less URL, or a value containing whitespace or
# control characters is refused when read, and no PayPal order is created.
# These are server-side configuration only: no API request can supply or
# override them, and one pair serves both the catalog and the external
# purchase flows.
# PAYPAL_RETURN_URL=https://your-app.example.com/paypal/return
# PAYPAL_CANCEL_URL=https://your-app.example.com/paypal/cancel

# External capture deadline (Phase 11F-D). OPTIONAL, default 900 (15 min).
# How long an EXPLICIT capture authorization stays usable before capture
# refuses with CAPTURE_AUTHORIZATION_EXPIRED. Authorizing again opens a
# fresh window.
#
# This is a checkout deadline in its own right and is DELIBERATELY NOT
# EXTERNAL_REVALIDATION_TTL_SECONDS: that one asks whether the discovery
# evidence shown to the user is still fresh, this one asks whether the
# decision to collect money is still current. Must be a positive integer;
# anything else is refused at read time rather than silently defaulted.
# EXTERNAL_CAPTURE_WINDOW_SECONDS=900

# PayPal webhook verification (Phase 8A).
# The Webhook ID shown in the PayPal Developer Dashboard after you register a
# webhook URL for your Sandbox app. Required to verify webhook signatures.
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id-here

# AI Intent Agent — provider-agnostic. Choose the backend:
#   AI_PROVIDER=gemini   (default),   AI_PROVIDER=claude,   or   AI_PROVIDER=groq
AI_PROVIDER=groq

# Google Gemini (default provider). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the default model (gemini-2.5-flash).
GEMINI_MODEL=

# Anthropic Claude (optional alternate provider; only needed if AI_PROVIDER=claude).
CLAUDE_API_KEY=
# Optional: override the default model (claude-opus-5-5).
CLAUDE_MODEL=

# Groq (alternate provider, Phase 8F; only needed if AI_PROVIDER=groq).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the default model.
GROQ_MODEL=openai/gpt-oss-20b

# Channel3 product discovery (Phase 10B). Get a key at https://trychannel3.com
# Discovery data only — Channel3 prices are never used as payment amounts.
CHANNEL3_API_KEY=
# Optional: HTTP timeout in seconds for Channel3 requests (default 15).
CHANNEL3_TIMEOUT_SECONDS=

# Discovery provider selection (Phase 10D): "channel3" (default) or "serper".
# Exactly one provider serves each request; only the selected provider's
# API key is required.
DISCOVERY_PROVIDER=channel3

# Serper (Google Shopping) discovery (Phase 10D). Key: https://serper.dev
# Discovery data only — Serper prices are never used as payment amounts.
SERPER_API_KEY=
# Optional: HTTP timeout in seconds for Serper requests (default 15).
SERPER_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# Discovery currency normalization (Phase 10F).
#
# USD -> INR rate used ONLY to derive a comparable INR price for externally
# discovered products, so a rupee budget can be judged against a USD-priced
# search result. Research/comparison/display only: this rate can NEVER
# become a PayPal order amount, a capture amount, or a refund amount.
#
# This is a CONFIGURED DEMONSTRATION RATE, not a live market quote, and it is
# reported as conversion_source="configured_demo_rate" in API responses.
# Leave it blank to use the documented default (91.25).
#
# It is deliberately separate from the PayPal demo conversion
# (currency_service.DEMO_INR_PER_USD, INR -> USD, fixed at 90), which belongs
# to the payment core. Changing one must never move the other.
DISCOVERY_USD_INR_RATE=

# ---------------------------------------------------------------------------
# External-product approval freshness TTL (Phase 11D).
#
# How recently the discovery provider must have CONFIRMED an externally
# discovered product (the revalidation snapshot's own server-side
# checked_at) for an explicit purchase approval to be prepared, or to be
# resolved into APPROVED. The rule is inclusive at the boundary:
#
#     checked_at + TTL >= now
#
# The same bound sets the approval's expires_at (checked_at + TTL), so an
# approval can never outlive the evidence it commits to.
#
# Enforced server-side and never taken from a client timestamp. There is no
# "unlimited" setting: a value of 0 or less, or a non-integer, is a
# configuration error that fails closed rather than defaulting silently.
#
# Leave blank to use the documented default (300 = 5 minutes), which matches
# the pending-action TTL so the system's two human-decision windows behave
# alike. Conservative on purpose: this governs the evidence a human is asked
# to commit money against, and a retailer can change a price at any moment.
EXTERNAL_REVALIDATION_TTL_SECONDS=

# ---------------------------------------------------------------------------
# Single-operator authentication (Phase 11F-H).
#
# The backend API is gated behind one operator login. BOTH values below are
# REQUIRED for authentication to work: if either is unset, POST /auth/login
# returns 503 and every protected route returns 401 (fail closed). There is
# deliberately no universal default key and no default signing secret — a
# predictable secret would let anyone forge a token.
#
# These are SERVER-SIDE ONLY. Never place either value in a VITE_ variable or
# anywhere the frontend bundle can read it; the browser only ever holds the
# short-lived token returned by /auth/login, in memory.
#
# PAYPILOT_API_KEY: the operator's login credential. Sent once to
#   /auth/login and checked with a constant-time comparison. Use a long
#   random string, not a dictionary word.
#
# PAYPILOT_AUTH_SECRET: high-entropy secret that signs the HMAC-SHA256 bearer
#   tokens (~30 min lifetime). Rotating it immediately invalidates every
#   issued token. Generate a fresh one per environment, e.g.:
#       python -c "import secrets; print(secrets.token_urlsafe(48))"
#   (or:  openssl rand -base64 48 ). Keep dev and production values distinct.
PAYPILOT_API_KEY=your-operator-login-key-here
PAYPILOT_AUTH_SECRET=generate-a-48-byte-random-secret-here
